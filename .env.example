# Supabase project URL and anon/public key (never use the service_role key in the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# Public site URL; use the final HTTPS URL for OAuth callback redirects
NUXT_SITE_URL=https://your-domain.example
NUXT_SITE_NAME=拾光导航 | nav-station
NUXT_SITE_DESCRIPTION=轻量、简洁的个人网址导航
NUXT_SITE_KEYWORDS=拾光导航,网址导航,效率工具,网站收藏
